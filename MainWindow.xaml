<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        xmlns:customControls="clr-namespace:MusicPlayer.Controls"
        mc:Ignorable="d"
        Background="Black"
        Foreground="White"
        Title="MainWindow" 
        Height="630" Width="1120"
        MinWidth="800"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="Margin" Value="5, 0"></Setter>
            <Setter Property="Padding" Value="8"></Setter>
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="Padding" Value="8"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="CaretBrush" Value="White"></Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="White"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto" MinHeight="80" MaxHeight="120"></RowDefinition>
        </Grid.RowDefinitions>

        <!--TaskBar-->
        <Border Grid.Row="0" Background="#000000" Margin="8">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Content="Home" Background="#2A2A2A"></Button>
                <TextBox Width="300" Margin="4, 0" Background="#2A2A2A"></TextBox>
            </StackPanel>
        </Border>

        <!--Library & Content-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="150" MaxWidth="220"></ColumnDefinition>
                <ColumnDefinition Width="4*" MinWidth="350"></ColumnDefinition>
                <ColumnDefinition Width="1.5*" MinWidth="220" MaxWidth="320"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#121212" CornerRadius="10" Padding="8"  Margin="8, 0, 0, 0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your Library" FontWeight="Bold" VerticalAlignment="Center" FontSize="18"></TextBlock>
                        <Button Content="+" Grid.Column="1" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"></Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Playlist"></Button>
                        <Button Content="Artists"></Button>
                        <Button Content="Albums"></Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#181818" CornerRadius="10" Margin="8, 0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Song name"></TextBlock>
                        <TextBlock Grid.Column="1" Text="Artist"></TextBlock>
                        <TextBlock Grid.Column="2" Text="Date added"></TextBlock>
                        <TextBlock Grid.Column="3" Text="⌚"></TextBlock>
                    </Grid>
                    <ListView x:Name="lvSongs" MouseDoubleClick="lvSongs_MouseDoubleClick" Grid.Row="1" 
                              ItemsSource="{Binding Songs}"
                              Background="Transparent" BorderThickness="0" Foreground="White"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="80"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"></TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Artists}" TextTrimming="CharacterEllipsis"></TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding DateAdded, StringFormat=dd/MM/yyyy}" TextTrimming="CharacterEllipsis"></TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding Duration, StringFormat=m\\:ss}" TextTrimming="CharacterEllipsis"></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border x:Name="bdNowPlaying" Grid.Column="2" Background="#121212" CornerRadius="10" Margin="0, 0, 8, 0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Now playing" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                    <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource self}}">
                        <Border Background="#2A2A2A" CornerRadius="8">
                            <Viewbox>
                                <TextBlock Text="🎵" Margin="10"></TextBlock>
                            </Viewbox>
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Grid>
                    <TextBlock Text="{Binding Title, FallbackValue='Have not played any songs yet'}" FontWeight="Bold" FontSize="20" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Artists, FallbackValue='No artist'}" Foreground="Gray" FontSize="14" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!--Music play bar-->
        <Border x:Name="bdPlayingBar" Grid.Row="2" Background="#000000" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto" MinWidth="400"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, FallbackValue='Have not played any songs yet'}" 
                               FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis"></TextBlock>
                    <TextBlock Text="{Binding Artists, FallbackValue='No artist'}" 
                               Foreground="Gray" FontSize="14" TextTrimming="CharacterEllipsis"></TextBlock>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="btnShuffle" Content="🔀" FontSize="20" Click="btnShuffle_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleEnable}" Value="True">
                                            <Setter Property="Foreground" Value="LightGreen"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnPreviousSong" Content="⏮" FontSize="20" Click="btnPreviousSong_Click"></Button>
                        <Button x:Name="btnPlayStop" Content="▶" FontSize="25" Click="butPlayStop_Click"></Button>
                        <Button x:Name="btnNextSong" Content="⏭" FontSize="20" Click="btnNextSong_Click"></Button>
                        <Button x:Name="btnRepeat" FontSize="20" Click="btnRepeat_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="🔁"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentRepeatMode}" Value="All">
                                            <Setter Property="Foreground" Value="LightGreen"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentRepeatMode}" Value="One">
                                            <Setter Property="Content" Value="🔂"></Setter>
                                            <Setter Property="Foreground" Value="LightGreen"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtCurrentTime" Text="0:00" VerticalAlignment="Center" Margin="3,0"></TextBlock>
                        <customControls:SeekSlider x:Name="sldProgress" 
                                Grid.Column="1" Minimum="0" 
                                Maximum="{Binding Duration.TotalSeconds, FallbackValue=100}"
                                ValueChanged="sldProgress_ValueChanged"
                                ></customControls:SeekSlider>
                        <TextBlock Text="{Binding Duration, StringFormat=m\\:ss, FallbackValue='0:00'}" Grid.Column="2" VerticalAlignment="Center" Margin="3,0"></TextBlock>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="*" MaxWidth="200"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtVolumeIcon" MouseLeftButtonDown="txtVolumeIcon_MouseLeftButtonDown"  Grid.Column="1" Text="🔊" FontSize="25" VerticalAlignment="Center"></TextBlock>
                    <customControls:SeekSlider x:Name="sldVolume" 
                            ValueChanged="sldVolume_ValueChanged" 
                            Grid.Column="2" 
                            Minimum="0" Maximum="1" Value="0.5" 
                            VerticalAlignment="Center">
                    </customControls:SeekSlider>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
